/* ==========================================================================
   DHARUN KUMAR S — PROFESSIONAL PORTFOLIO
   Design System & Global Variables
   ========================================================================== */
:root {
  /* Colour Palette — Warm Professional Light Theme */
  --bg:            #F7F6F3;          /* warm off-white */
  --bg-secondary:  #EFEDE9;          /* slightly deeper warm white */
  --bg-card:       #FFFFFF;          /* pure white cards */
  --bg-card-hover: #F9F8F6;

  /* Text */
  --heading:       #1A1A2E;          /* deep charcoal */
  --body-text:     #374151;          /* dark grey */
  --text-muted:    #6B7280;          /* slate grey */
  --text-light:    #9CA3AF;

  /* Accent — Professional Cobalt Blue */
  --accent:        #2563EB;          /* cobalt blue */
  --accent-hover:  #1D4ED8;
  --accent-light:  rgba(37, 99, 235, 0.08);
  --accent-mid:    rgba(37, 99, 235, 0.15);

  /* Supporting — Teal, used sparingly */
  --teal:          #0F766E;
  --teal-light:    rgba(15, 118, 110, 0.08);

  /* Borders */
  --border:        #E5E2DB;          /* soft neutral grey */
  --border-hover:  #D1CCC3;

  /* Typography */
  --font-heading: 'Space Grotesk', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  --font-body:    'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;

  /* Layout */
  --header-height: 72px;
  --container-max: 1160px;
  --section-pad:   96px;

  /* Motion */
  --ease: cubic-bezier(0.16, 1, 0.3, 1);
  --transition: all 0.2s ease;
  --transition-med: all 0.35s var(--ease);
}

/* --------------------------------------------------------------------------
   Reset & Base
   -------------------------------------------------------------------------- */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: var(--header-height);
  -webkit-text-size-adjust: 100%;
}

body {
  background-color: var(--bg);
  color: var(--body-text);
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.65;
  overflow-x: hidden;
  position: relative;
  /* Subtle warm paper texture via CSS */
  background-image:
    radial-gradient(ellipse at 20% 50%, rgba(37, 99, 235, 0.03) 0%, transparent 60%),
    radial-gradient(ellipse at 80% 20%, rgba(15, 118, 110, 0.02) 0%, transparent 50%);
}

/* Scrollbar */
::-webkit-scrollbar { width: 8px; }
::-webkit-scrollbar-track { background: var(--bg-secondary); }
::-webkit-scrollbar-thumb {
  background: var(--border-hover);
  border: 2px solid var(--bg-secondary);
  border-radius: 4px;
}
::-webkit-scrollbar-thumb:hover { background: var(--text-muted); }

/* Focus Indicators */
a:focus, button:focus, input:focus, textarea:focus { outline: none; }
a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
  border-radius: 4px;
}

/* Selection */
::selection {
  background-color: rgba(37, 99, 235, 0.15);
  color: var(--heading);
}

/* --------------------------------------------------------------------------
   Layout
   -------------------------------------------------------------------------- */
.container {
  width: 100%;
  max-width: var(--container-max);
  margin: 0 auto;
  padding: 0 28px;
}

.section {
  padding: var(--section-pad) 0;
  position: relative;
}

/* ==========================================================================
   BACKGROUND — Subtle floating dot mesh
   ========================================================================== */
#ambient-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
  pointer-events: none;
  opacity: 1;
}

/* Ensure all content sits above the canvas */
header, main, footer, .mobile-nav, .mobile-nav-overlay {
  position: relative;
  z-index: 1;
}

/* ==========================================================================
   GLASS / CARD TOKEN
   ========================================================================== */
.card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 14px;
  transition: var(--transition-med);
}

.card:hover {
  border-color: var(--border-hover);
  box-shadow: 0 8px 32px rgba(26, 26, 46, 0.07);
}

/* ==========================================================================
   BUTTONS
   ========================================================================== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 11px 24px;
  font-family: var(--font-heading);
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
  border-radius: 8px;
  cursor: pointer;
  border: 1px solid transparent;
  transition: var(--transition-med);
  white-space: nowrap;
}

.btn-primary {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
  box-shadow: 0 2px 8px rgba(37, 99, 235, 0.25);
}

.btn-primary:hover {
  background: var(--accent-hover);
  border-color: var(--accent-hover);
  box-shadow: 0 4px 16px rgba(37, 99, 235, 0.35);
  transform: translateY(-1px);
}

.btn-secondary {
  background: transparent;
  border-color: var(--border-hover);
  color: var(--heading);
}

.btn-secondary:hover {
  border-color: var(--accent);
  color: var(--accent);
  background: var(--accent-light);
  transform: translateY(-1px);
}

.btn-resume {
  background: transparent;
  border-color: var(--border);
  color: var(--text-muted);
  font-size: 13px;
  padding: 10px 20px;
}

.btn-resume:hover {
  border-color: var(--accent);
  color: var(--accent);
  background: var(--accent-light);
}

.btn-full { width: 100%; }

.btn-arrow {
  font-weight: 700;
  display: inline-block;
  transition: transform 0.2s ease;
}

.btn:hover .btn-arrow { transform: translateX(3px); }
.btn-resume:hover .btn-arrow { transform: translateY(2px); }

/* ==========================================================================
   NAVIGATION BAR
   ========================================================================== */
.header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: var(--header-height);
  z-index: 100;
  background-color: rgba(247, 246, 243, 0.88);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid transparent;
  transition: var(--transition-med);
}

.header.scrolled {
  border-bottom-color: var(--border);
  box-shadow: 0 1px 12px rgba(26, 26, 46, 0.06);
}

.header-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100%;
  max-width: var(--container-max);
  margin: 0 auto;
  padding: 0 28px;
}

/* DK Monogram Logo */
.logo {
  font-family: var(--font-heading);
  font-size: 17px;
  font-weight: 700;
  color: var(--heading);
  text-decoration: none;
  letter-spacing: -0.3px;
  transition: color 0.2s ease;
  display: flex;
  align-items: center;
  gap: 8px;
}

.logo-monogram {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  background: var(--accent);
  color: #fff;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: -0.5px;
  flex-shrink: 0;
}

.logo:hover { color: var(--accent); }

/* Desktop Nav */
.nav-desktop { display: block; }

.nav-list {
  display: flex;
  list-style: none;
  gap: 4px;
  align-items: center;
}

.nav-link {
  font-family: var(--font-heading);
  font-size: 14px;
  font-weight: 500;
  text-decoration: none;
  color: var(--text-muted);
  transition: color 0.2s ease;
  padding: 6px 10px;
  border-radius: 6px;
  position: relative;
}

.nav-link:hover { color: var(--heading); }

.nav-link.active {
  color: var(--accent);
  font-weight: 600;
}

.nav-link::after {
  content: '';
  position: absolute;
  bottom: 2px;
  left: 10px;
  right: 10px;
  height: 2px;
  background: var(--accent);
  border-radius: 2px;
  transform: scaleX(0);
  transition: transform 0.2s ease;
}

.nav-link.active::after { transform: scaleX(1); }
.nav-link:hover::after { transform: scaleX(0.5); }

/* Header Actions */
.header-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

/* Hamburger */
.nav-toggle {
  display: none;
  flex-direction: column;
  justify-content: space-between;
  width: 22px;
  height: 16px;
  background: none;
  border: none;
  cursor: pointer;
  z-index: 110;
  padding: 0;
}

.hamburger-line {
  width: 100%;
  height: 2px;
  background-color: var(--heading);
  border-radius: 2px;
  transition: var(--transition-med);
}

.nav-toggle[aria-expanded="true"] .hamburger-line:nth-child(1) {
  transform: translateY(7px) rotate(45deg);
}
.nav-toggle[aria-expanded="true"] .hamburger-line:nth-child(2) { opacity: 0; }
.nav-toggle[aria-expanded="true"] .hamburger-line:nth-child(3) {
  transform: translateY(-7px) rotate(-45deg);
}

/* ==========================================================================
   MOBILE SIDEBAR DRAWER
   ========================================================================== */
.mobile-nav-overlay {
  position: fixed;
  inset: 0;
  background: rgba(26, 26, 46, 0.4);
  backdrop-filter: blur(4px);
  z-index: 98;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.mobile-nav-overlay.active {
  opacity: 1;
  pointer-events: auto;
}

.mobile-nav {
  position: fixed;
  top: 0;
  right: -300px;
  width: 280px;
  height: 100vh;
  background: var(--bg-card);
  border-left: 1px solid var(--border);
  z-index: 99;
  display: flex;
  flex-direction: column;
  padding: 28px 24px;
  transition: right 0.35s var(--ease);
  box-shadow: -4px 0 24px rgba(26, 26, 46, 0.08);
}

.mobile-nav.active { right: 0; }

.mobile-nav-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40px;
}

.nav-close {
  background: none;
  border: none;
  font-size: 24px;
  color: var(--text-muted);
  cursor: pointer;
  transition: color 0.2s;
  line-height: 1;
}

.nav-close:hover { color: var(--heading); }

.mobile-nav-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.mobile-nav-link {
  font-family: var(--font-heading);
  font-size: 16px;
  font-weight: 500;
  text-decoration: none;
  color: var(--text-muted);
  display: block;
  padding: 10px 12px;
  border-radius: 8px;
  transition: var(--transition);
}

.mobile-nav-link:hover {
  color: var(--accent);
  background: var(--accent-light);
}

.mobile-nav-footer {
  margin-top: auto;
  padding-top: 24px;
  border-top: 1px solid var(--border);
}

/* ==========================================================================
   HERO SECTION
   ========================================================================== */
.hero-section {
  padding-top: calc(var(--header-height) + 56px);
  padding-bottom: 80px;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.hero-container {
  display: grid;
  grid-template-columns: 1fr 1.15fr;
  gap: 72px;
  align-items: center;
}

/* ---------- Hero Left: Portrait ---------- */
.hero-image-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
}

.portrait-container {
  position: relative;
  display: inline-block;
  animation: heroEnter 0.9s var(--ease) both;
}

@keyframes heroEnter {
  from { opacity: 0; transform: translateY(24px); }
  to   { opacity: 1; transform: translateY(0); }
}

.profile-frame {
  width: 320px;
  height: 380px;
  border-radius: 18px;
  overflow: hidden;
  border: 1px solid var(--border);
  box-shadow:
    0 4px 24px rgba(26, 26, 46, 0.08),
    0 1px 4px rgba(26, 26, 46, 0.04);
  transition: box-shadow 0.3s ease;
  background: var(--bg-secondary);
}

.profile-frame:hover {
  box-shadow:
    0 8px 40px rgba(26, 26, 46, 0.12),
    0 2px 8px rgba(26, 26, 46, 0.06);
}

.profile-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 10%;
  display: block;
  transition: transform 0.5s ease;
}

.profile-frame:hover .profile-img {
  transform: scale(1.02);
}

/* Availability badge under portrait */
.portrait-badge {
  position: absolute;
  bottom: -16px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 24px;
  padding: 7px 18px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-heading);
  font-size: 12px;
  font-weight: 600;
  color: var(--text-muted);
  box-shadow: 0 4px 16px rgba(26, 26, 46, 0.08);
  white-space: nowrap;
}

.badge-dot {
  width: 7px;
  height: 7px;
  background: #16a34a;
  border-radius: 50%;
  animation: pulse-green 2s ease-in-out infinite;
  flex-shrink: 0;
}

@keyframes pulse-green {
  0%, 100% { box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.4); }
  50%       { box-shadow: 0 0 0 5px rgba(22, 163, 74, 0); }
}

/* ---------- Hero Right: Content ---------- */
.hero-content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  animation: heroContentEnter 0.9s var(--ease) 0.15s both;
}

@keyframes heroContentEnter {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}

.hero-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--accent-light);
  border: 1px solid rgba(37, 99, 235, 0.2);
  color: var(--accent);
  font-family: var(--font-heading);
  font-size: 12px;
  font-weight: 600;
  padding: 5px 14px;
  border-radius: 24px;
  margin-bottom: 20px;
  letter-spacing: 0.2px;
}

.hero-title {
  font-family: var(--font-heading);
  font-size: 52px;
  font-weight: 700;
  line-height: 1.08;
  letter-spacing: -1.5px;
  color: var(--heading);
  margin-bottom: 14px;
}

.hero-subtitle {
  font-family: var(--font-heading);
  font-size: 21px;
  font-weight: 500;
  color: var(--body-text);
  margin-bottom: 18px;
  height: 34px;
  display: flex;
  align-items: center;
}

.typewriter-text {
  color: var(--accent);
  font-weight: 600;
}

.typewriter-cursor {
  animation: blink 1s step-end infinite;
  color: var(--text-muted);
  margin-left: 2px;
  font-weight: 300;
}

@keyframes blink {
  from, to { opacity: 0; }
  50%       { opacity: 1; }
}

.hero-subtext {
  font-size: 16px;
  color: var(--text-muted);
  line-height: 1.7;
  margin-bottom: 32px;
  max-width: 520px;
}

.hero-buttons {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 32px;
}

/* Hero Socials */
.hero-socials {
  display: flex;
  align-items: center;
  gap: 16px;
}

.socials-label {
  font-family: var(--font-heading);
  font-size: 12px;
  font-weight: 600;
  color: var(--text-light);
  text-transform: uppercase;
  letter-spacing: 0.8px;
}

.socials-icons {
  display: flex;
  gap: 8px;
}

.hero-social-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border-radius: 8px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  color: var(--text-muted);
  transition: var(--transition-med);
}

.hero-social-link:hover {
  color: var(--accent);
  border-color: rgba(37, 99, 235, 0.35);
  background: var(--accent-light);
  transform: translateY(-2px);
}

/* Scroll indicator */
.scroll-indicator {
  position: absolute;
  bottom: 28px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  text-decoration: none;
  color: var(--text-light);
  transition: color 0.2s;
  z-index: 2;
}

.scroll-indicator:hover { color: var(--accent); }

.mouse-icon {
  width: 20px;
  height: 32px;
  border: 2px solid var(--border-hover);
  border-radius: 12px;
  display: flex;
  justify-content: center;
  padding-top: 5px;
}

.mouse-wheel {
  width: 2px;
  height: 6px;
  background: var(--accent);
  border-radius: 2px;
  animation: mouseScroll 2s ease-in-out infinite;
}

@keyframes mouseScroll {
  0%   { transform: translateY(0); opacity: 1; }
  100% { transform: translateY(10px); opacity: 0; }
}

.scroll-text {
  font-family: var(--font-heading);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
}

/* ==========================================================================
   SECTION TITLE STYLE
   ========================================================================== */
.section-title-wrapper {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-bottom: 52px;
}

.section-label {
  font-family: var(--font-heading);
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: var(--accent);
}

.section-title {
  font-family: var(--font-heading);
  font-size: 30px;
  font-weight: 700;
  color: var(--heading);
  letter-spacing: -0.5px;
  white-space: nowrap;
}

.section-line {
  flex-grow: 1;
  height: 1px;
  background: var(--border);
}

/* ==========================================================================
   ABOUT SECTION
   ========================================================================== */
.about-grid {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 52px;
  align-items: start;
}

.about-content {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.about-para {
  font-size: 16px;
  color: var(--text-muted);
  line-height: 1.75;
}

.about-para.lead-text {
  font-size: 17px;
  color: var(--body-text);
  font-weight: 450;
  line-height: 1.7;
}

.highlight-blue {
  color: var(--accent);
  font-weight: 600;
}

/* Quick Facts Card */
.quick-facts-card {
  padding: 28px;
}

.facts-header h3 {
  font-family: var(--font-heading);
  font-size: 16px;
  font-weight: 700;
  color: var(--heading);
  margin-bottom: 20px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--border);
}

.facts-body {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.fact-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid var(--border);
}

.fact-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.fact-label {
  font-family: var(--font-heading);
  font-size: 12px;
  font-weight: 600;
  color: var(--text-light);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  flex-shrink: 0;
}

.fact-value {
  font-size: 13px;
  color: var(--body-text);
  font-weight: 500;
  text-align: right;
}

.status-available {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #16a34a !important;
  font-weight: 600;
}

.pulse-dot {
  width: 7px;
  height: 7px;
  background: #16a34a;
  border-radius: 50%;
  animation: pulse-green 2s ease-in-out infinite;
}

/* ==========================================================================
   SKILLS SECTION
   ========================================================================== */
.skills-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.skills-category {
  padding: 28px;
  transition: var(--transition-med);
}

.skills-category:hover {
  border-color: rgba(37, 99, 235, 0.25);
  box-shadow: 0 8px 32px rgba(37, 99, 235, 0.06);
  transform: translateY(-2px);
}

.category-title {
  font-family: var(--font-heading);
  font-size: 16px;
  font-weight: 700;
  color: var(--heading);
  margin-bottom: 22px;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--border);
}

.skills-list {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.skill-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.skill-name {
  font-size: 14px;
  font-weight: 500;
  color: var(--body-text);
}

.skill-percentage {
  font-family: var(--font-heading);
  font-size: 13px;
  font-weight: 700;
  color: var(--accent);
}

.skill-bar-track {
  width: 100%;
  height: 5px;
  background: var(--bg-secondary);
  border-radius: 10px;
  overflow: hidden;
}

.skill-bar-fill {
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg, var(--accent) 0%, #60a5fa 100%);
  border-radius: 10px;
  transition: width 1.4s cubic-bezier(0.16, 1, 0.3, 1);
}

/* ==========================================================================
   PROJECTS SECTION
   ========================================================================== */
.projects-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
}

.project-card {
  padding: 32px;
  display: flex;
  flex-direction: column;
  transition: var(--transition-med);
  position: relative;
  overflow: hidden;
}

.project-card:hover {
  border-color: rgba(37, 99, 235, 0.2);
  box-shadow: 0 12px 40px rgba(26, 26, 46, 0.09);
  transform: translateY(-2px);
}

/* Subtle top accent line on hover */
.project-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--accent);
  border-radius: 14px 14px 0 0;
  transform: scaleX(0);
  transition: transform 0.3s ease;
}

.project-card:hover::before { transform: scaleX(1); }

.project-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.project-number {
  font-family: var(--font-heading);
  font-size: 11px;
  font-weight: 700;
  color: var(--text-light);
  letter-spacing: 1px;
  text-transform: uppercase;
}

.project-status {
  font-family: var(--font-heading);
  font-size: 10px;
  font-weight: 700;
  color: var(--text-light);
  border: 1px solid var(--border);
  padding: 3px 8px;
  border-radius: 4px;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

.project-status.live {
  color: #16a34a;
  background: rgba(22, 163, 74, 0.06);
  border-color: rgba(22, 163, 74, 0.25);
}

.project-title {
  font-family: var(--font-heading);
  font-size: 20px;
  font-weight: 700;
  color: var(--heading);
  margin-bottom: 10px;
  line-height: 1.25;
}

.project-desc {
  font-size: 14px;
  color: var(--text-muted);
  line-height: 1.65;
  margin-bottom: 20px;
}

.project-features {
  margin-bottom: 20px;
  background: var(--bg-secondary);
  border-radius: 8px;
  padding: 14px 16px;
  border: 1px solid var(--border);
}

.features-label {
  display: block;
  font-family: var(--font-heading);
  font-size: 11px;
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 8px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.features-list { list-style: none; }

.features-list li {
  font-size: 13px;
  color: var(--body-text);
  position: relative;
  padding-left: 14px;
  margin-bottom: 5px;
  line-height: 1.5;
}

.features-list li:last-child { margin-bottom: 0; }

.features-list li::before {
  content: "–";
  color: var(--accent);
  position: absolute;
  left: 0;
}

.project-tech {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 24px;
  flex-grow: 1;
}

.tech-tag {
  font-family: var(--font-heading);
  font-size: 11px;
  font-weight: 600;
  color: var(--text-muted);
  background: var(--bg-secondary);
  border: 1px solid var(--border);
  padding: 3px 10px;
  border-radius: 5px;
  letter-spacing: 0.2px;
}

.project-actions { display: flex; gap: 10px; }

.btn-project-demo {
  background: var(--accent-light);
  border: 1px solid rgba(37, 99, 235, 0.2);
  color: var(--accent);
  padding: 9px 18px;
  font-size: 13px;
}

.btn-project-demo:hover {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
}

/* ==========================================================================
   EXPERIENCE TIMELINE SECTION
   ========================================================================== */
.timeline {
  position: relative;
  max-width: 960px;
  margin: 0 auto;
  padding: 20px 0;
}

.timeline-line-track {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  width: 1px;
  background: var(--border);
  transform: translateX(-50%);
}

.timeline-line-fill {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 0%;
  background: var(--accent);
  transition: height 0.1s linear;
}

.timeline-nodes-container { position: relative; }

.timeline-node {
  position: relative;
  width: 100%;
  margin-bottom: 52px;
  display: flex;
  justify-content: flex-start;
}

.timeline-node:nth-child(even) { justify-content: flex-end; }
.timeline-node:last-child { margin-bottom: 0; }

.node-indicator {
  position: absolute;
  top: 24px;
  left: 50%;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: var(--bg-card);
  border: 2px solid var(--border);
  transform: translate(-50%, -50%);
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition);
}

.node-dot {
  width: 7px;
  height: 7px;
  background: var(--text-light);
  border-radius: 50%;
  transition: var(--transition);
}

.timeline-node.passed .node-indicator { border-color: var(--accent); }
.timeline-node.passed .node-dot { background: var(--accent); }

.node-card {
  width: 45%;
  padding: 26px 28px;
}

.node-date {
  font-family: var(--font-heading);
  font-size: 12px;
  font-weight: 700;
  color: var(--accent);
  letter-spacing: 0.3px;
  display: block;
  margin-bottom: 6px;
  text-transform: uppercase;
}

.node-title {
  font-family: var(--font-heading);
  font-size: 16px;
  font-weight: 700;
  color: var(--heading);
  margin-bottom: 8px;
  line-height: 1.3;
}

.node-desc {
  font-size: 14px;
  color: var(--text-muted);
  line-height: 1.65;
}

/* Active node */
.timeline-node.active-node .node-indicator {
  border-color: var(--accent);
  width: 22px;
  height: 22px;
}

.timeline-node.active-node .node-dot {
  background: var(--accent);
  width: 9px;
  height: 9px;
  animation: pulse-blue 1.5s ease-in-out infinite;
}

@keyframes pulse-blue {
  0%, 100% { box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.4); }
  50%       { box-shadow: 0 0 0 5px rgba(37, 99, 235, 0); }
}

.timeline-node.active-node .node-card {
  border-color: rgba(37, 99, 235, 0.25);
  box-shadow: 0 4px 20px rgba(37, 99, 235, 0.06);
}

.active-badge {
  display: inline-block;
  background: var(--accent-light);
  border: 1px solid rgba(37, 99, 235, 0.2);
  color: var(--accent);
  font-family: var(--font-heading);
  font-size: 10px;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: 4px;
  margin-bottom: 10px;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

/* ==========================================================================
   CERTIFICATIONS SECTION
   ========================================================================== */
.certs-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}

.cert-card {
  display: flex;
  align-items: center;
  gap: 20px;
  padding: 24px;
  transition: var(--transition-med);
}

.cert-card:hover {
  border-color: rgba(37, 99, 235, 0.2);
  transform: translateX(4px);
}

.cert-icon-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  border-radius: 12px;
  background: var(--accent-light);
  border: 1px solid rgba(37, 99, 235, 0.12);
  color: var(--accent);
  flex-shrink: 0;
}

.cert-info { display: flex; flex-direction: column; }

.cert-issuer {
  font-family: var(--font-heading);
  font-size: 11px;
  font-weight: 700;
  color: var(--text-light);
  text-transform: uppercase;
  letter-spacing: 0.8px;
  margin-bottom: 4px;
}

.cert-title {
  font-family: var(--font-heading);
  font-size: 15px;
  font-weight: 700;
  color: var(--heading);
  line-height: 1.3;
}

/* ==========================================================================
   RESUME CALLOUT SECTION
   ========================================================================== */
.resume-callout {
  padding: 44px 48px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
  overflow: hidden;
  background: var(--bg-card);
}

/* Subtle left accent */
.resume-callout::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4px;
  background: var(--accent);
  border-radius: 14px 0 0 14px;
}

.resume-callout-content { position: relative; z-index: 1; }

.resume-callout-title {
  font-family: var(--font-heading);
  font-size: 24px;
  font-weight: 700;
  color: var(--heading);
  margin-bottom: 6px;
  letter-spacing: -0.3px;
}

.resume-callout-desc {
  font-size: 15px;
  color: var(--text-muted);
}

.resume-callout-action { position: relative; z-index: 1; }

/* ==========================================================================
   CONTACT SECTION
   ========================================================================== */
.contact-grid {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 48px;
  align-items: start;
}

.contact-info-panel {
  display: flex;
  flex-direction: column;
}

.contact-panel-title {
  font-family: var(--font-heading);
  font-size: 20px;
  font-weight: 700;
  color: var(--heading);
  margin-bottom: 10px;
  letter-spacing: -0.3px;
}

.contact-panel-desc {
  font-size: 15px;
  color: var(--text-muted);
  line-height: 1.65;
  margin-bottom: 28px;
}

.contact-channels {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.channel-card {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px 18px;
  text-decoration: none;
  transition: var(--transition-med);
}

.channel-card:hover {
  border-color: rgba(37, 99, 235, 0.25);
  transform: translateX(4px);
  background: var(--bg-card-hover);
}

.channel-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 10px;
  background: var(--accent-light);
  border: 1px solid rgba(37, 99, 235, 0.1);
  color: var(--accent);
  flex-shrink: 0;
  transition: var(--transition);
}

.channel-card:hover .channel-icon {
  background: var(--accent);
  color: #fff;
}

.channel-details { display: flex; flex-direction: column; }

.channel-label {
  font-family: var(--font-heading);
  font-size: 11px;
  font-weight: 700;
  color: var(--text-light);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.channel-value {
  font-size: 14px;
  color: var(--body-text);
  font-weight: 500;
}

/* Form */
.contact-form-wrapper { padding: 36px; }

.contact-panel-title.form-title {
  font-size: 18px;
  margin-bottom: 6px;
}

.contact-form {
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin-top: 20px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.form-label {
  font-family: var(--font-heading);
  font-size: 13px;
  font-weight: 600;
  color: var(--body-text);
}

.form-input {
  width: 100%;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 11px 14px;
  font-family: var(--font-body);
  font-size: 14px;
  color: var(--heading);
  transition: var(--transition);
}

.form-input::placeholder { color: var(--text-light); }

.form-input:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
  background: var(--bg-card);
  outline: none;
}

.form-textarea { resize: vertical; min-height: 120px; }

.btn-submit {
  border: none;
  font-family: var(--font-heading);
  font-size: 14px;
  padding: 13px 28px;
}

/* ==========================================================================
   FOOTER
   ========================================================================== */
.footer {
  background: var(--bg-card);
  border-top: 1px solid var(--border);
  padding: 36px 0;
  margin-top: 48px;
}

.footer-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.footer-copy {
  font-size: 13px;
  color: var(--text-muted);
}

.footer-socials { display: flex; gap: 10px; }

.footer-social-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 8px;
  background: var(--bg-secondary);
  border: 1px solid var(--border);
  color: var(--text-muted);
  transition: var(--transition-med);
}

.footer-social-link:hover {
  color: var(--accent);
  border-color: rgba(37, 99, 235, 0.3);
  background: var(--accent-light);
  transform: translateY(-2px);
}

/* ==========================================================================
   SCROLL-REVEAL ANIMATION
   ========================================================================== */
.scroll-reveal {
  opacity: 0;
  transform: translateY(28px);
  transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);
}

.scroll-reveal.revealed {
  opacity: 1;
  transform: translateY(0);
}

/* ==========================================================================
   REDUCED MOTION
   ========================================================================== */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
  .scroll-reveal {
    opacity: 1;
    transform: none;
    transition: none;
  }
  html { scroll-behavior: auto; }
  #ambient-canvas { display: none; }
}

/* ==========================================================================
   HONEYPOT
   ========================================================================== */
.hidden-honeypot { display: none !important; }

/* ==========================================================================
   RESPONSIVE
   ========================================================================== */

/* Tablets & Small Desktops (≤ 1024px) */
@media (max-width: 1024px) {
  :root {
    --section-pad: 72px;
  }

  .hero-container {
    grid-template-columns: 1fr;
    gap: 48px;
    text-align: center;
  }

  .hero-image-wrapper { justify-content: center; }
  .hero-content { align-items: center; }
  .hero-subtext { margin-left: auto; margin-right: auto; }
  .hero-buttons { justify-content: center; }
  .hero-socials { justify-content: center; }

  .scroll-indicator { display: none; }

  .about-grid { grid-template-columns: 1fr; gap: 36px; }
  .skills-grid { grid-template-columns: repeat(2, 1fr); }
  .projects-grid { grid-template-columns: 1fr; }

  .timeline-line-track { left: 20px; }
  .timeline-node { justify-content: flex-start !important; padding-left: 48px; }
  .node-card { width: 100%; }
  .node-indicator { left: 20px; }

  .contact-grid { grid-template-columns: 1fr; gap: 36px; }
  .resume-callout { flex-direction: column; text-align: center; gap: 24px; }
  .resume-callout::before { width: 100%; height: 4px; top: 0; right: 0; bottom: auto; border-radius: 14px 14px 0 0; }
}

/* Navigation collapse (≤ 768px) */
@media (max-width: 768px) {
  .nav-desktop { display: none; }
  .nav-toggle { display: flex; }

  .hero-title { font-size: 42px; }
  .profile-frame { width: 260px; height: 320px; }

  .skills-grid { grid-template-columns: 1fr; }
  .certs-grid { grid-template-columns: 1fr; }

  .footer-container { flex-direction: column; gap: 20px; text-align: center; }
}

/* Mobile (≤ 480px) */
@media (max-width: 480px) {
  :root { --section-pad: 56px; }

  .hero-title { font-size: 34px; letter-spacing: -1px; }
  .hero-subtitle { font-size: 18px; height: 30px; }

  .hero-buttons { flex-direction: column; width: 100%; }
  .hero-buttons .btn { width: 100%; justify-content: center; }

  .profile-frame { width: 220px; height: 270px; }

  .section-title { font-size: 24px; }
  .quick-facts-card, .contact-form-wrapper { padding: 20px 16px; }
  .node-card { padding: 20px 16px; }
  .project-card { padding: 24px 20px; }
  .resume-callout { padding: 28px 20px; }
}
