    <!-- ===== EXPERIENCE TIMELINE ===== -->
    <section class="section scroll-reveal" id="experience">
      <div class="container">
        <div class="section-title-wrapper">
          <h2 class="section-title">My Journey</h2>
          <div class="section-line"></div>
        </div>

        <div class="timeline">
          <div class="timeline-line-track">
            <div class="timeline-line-fill" id="timeline-fill"></div>
          </div>

          <div class="timeline-nodes-container">

            <div class="timeline-node" data-node="1">
              <div class="node-indicator"><span class="node-dot"></span></div>
              <div class="node-card card">
                <span class="node-date">2019 – 2022</span>
                <h3 class="node-title">Diploma, Electrical &amp; Electronics Engineering</h3>
                <p class="node-desc">Foundation in circuits, systems thinking and hands-on troubleshooting — the root of my technical curiosity.</p>
              </div>
            </div>

            <div class="timeline-node" data-node="2">
              <div class="node-indicator"><span class="node-dot"></span></div>
              <div class="node-card card">
                <span class="node-date">2 Years</span>
                <h3 class="node-title">Assembly Shop Technician — Hyundai Motor India</h3>
                <p class="node-desc">Executed vehicle assembly operations under strict quality standards, collaborated in fast-paced teams, and contributed to process improvements.</p>
              </div>
            </div>

            <div class="timeline-node" data-node="3">
              <div class="node-indicator"><span class="node-dot"></span></div>
              <div class="node-card card">
                <span class="node-date">2023 – Present</span>
                <h3 class="node-title">B.Tech Information Technology — K. Ramakrishnan College</h3>
                <p class="node-desc">Expected 2027. Building full-stack, database, and analytics projects alongside coursework.</p>
              </div>
            </div>

            <div class="timeline-node active-node" data-node="4">
              <div class="node-indicator"><span class="node-dot"></span></div>
              <div class="node-card card">
                <div class="active-badge">Active Development</div>
                <span class="node-date">Currently Building</span>
                <h3 class="node-title">Manganikka (Mango J) — Creator Portfolio &amp; Media Kit</h3>
                <p class="node-desc">Enterprise-grade portfolio for a Dubai-based Tamil YouTube creator, built with Next.js 16, TypeScript, Tailwind CSS v4 and shadcn/ui.</p>
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

