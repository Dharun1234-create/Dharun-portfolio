    <!-- ===== FEATURED PROJECTS ===== -->
    <section class="section scroll-reveal" id="projects">
      <div class="container">
        <div class="section-title-wrapper">
          <h2 class="section-title">Featured Projects</h2>
          <div class="section-line"></div>
        </div>

        <div class="projects-grid">

          <!-- Project 1 -->
          <article class="project-card card">
            <div class="project-meta">
              <span class="project-number">P.01</span>
              <span class="project-status live">Live Demo Available</span>
            </div>
            <h3 class="project-title">SmartBuild Estimator V3</h3>
            <p class="project-desc">
              A full-stack web app helping homeowners estimate construction costs and connect with contractors — secure auth, dashboards, and lead management for the early stages of construction planning.
            </p>
            <div class="project-features">
              <span class="features-label">Key Features</span>
              <ul class="features-list">
                <li>Firebase auth with email verification &amp; password reset</li>
                <li>Estimate management + contractor quote requests</li>
                <li>WhatsApp lead integration, fully responsive UI</li>
              </ul>
            </div>
            <div class="project-tech">
              <span class="tech-tag">HTML5</span>
              <span class="tech-tag">CSS3</span>
              <span class="tech-tag">JavaScript</span>
              <span class="tech-tag">Node.js</span>
              <span class="tech-tag">MongoDB</span>
              <span class="tech-tag">Firebase</span>
            </div>
            <div class="project-actions">
              <a href="https://dharun1234-create.github.io/smart-build-v3/" target="_blank" rel="noopener noreferrer" class="btn btn-project-demo">
                Live Demo <span class="btn-arrow">→</span>
              </a>
            </div>
          </article>

          <!-- Project 2 -->
          <article class="project-card card">
            <div class="project-meta">
              <span class="project-number">P.02</span>
              <span class="project-status">System</span>
            </div>
            <h3 class="project-title">Crime Record Management System</h3>
            <p class="project-desc">
              A Java-based application implementing full CRUD operations to manage and maintain crime records efficiently, enabling easy retrieval, update, and deletion of records.
            </p>
            <div class="project-features">
              <span class="features-label">Key Features</span>
              <ul class="features-list">
                <li>Full CRUD data lifecycle</li>
                <li>Structured record retrieval &amp; search</li>
                <li>Built for data integrity under frequent updates</li>
              </ul>
            </div>
            <div class="project-tech">
              <span class="tech-tag">Java</span>
              <span class="tech-tag">CRUD</span>
              <span class="tech-tag">Database Design</span>
            </div>
          </article>

          <!-- Project 3 -->
          <article class="project-card card">
            <div class="project-meta">
              <span class="project-number">P.03</span>
              <span class="project-status">Analytics</span>
            </div>
            <h3 class="project-title">Company Reputation Analysis</h3>
            <p class="project-desc">
              A sentiment analysis project leveraging news and social media data to evaluate and track company reputation, providing actionable insights through data visualization.
            </p>
            <div class="project-features">
              <span class="features-label">Key Features</span>
              <ul class="features-list">
                <li>News &amp; social sentiment aggregation</li>
                <li>Actionable reputation-trend visualizations</li>
              </ul>
            </div>
            <div class="project-tech">
              <span class="tech-tag">Data Analytics</span>
              <span class="tech-tag">Sentiment Analysis</span>
              <span class="tech-tag">Visualization</span>
            </div>
          </article>

          <!-- Project 4 -->
          <article class="project-card card">
            <div class="project-meta">
              <span class="project-number">P.04</span>
              <span class="project-status">Dashboard</span>
            </div>
            <h3 class="project-title">Sports Event Management System</h3>
            <p class="project-desc">
              An interactive Power BI dashboard solution for comprehensive sports analytics, enabling real-time tracking, event scheduling, and performance insights for sports management teams.
            </p>
            <div class="project-features">
              <span class="features-label">Key Features</span>
              <ul class="features-list">
                <li>Real-time tracking dashboard</li>
                <li>Event scheduling &amp; performance insights</li>
              </ul>
            </div>
            <div class="project-tech">
              <span class="tech-tag">Power BI</span>
              <span class="tech-tag">Analytics</span>
              <span class="tech-tag">Dashboarding</span>
            </div>
          </article>

        </div>
      </div>
